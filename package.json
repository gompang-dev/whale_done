    "expo-updates": "~29.0.18",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.2.1",
    "posthog-react-native": "^4.55.0",
    "posthog-react-native-session-replay": "^1.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.2",
