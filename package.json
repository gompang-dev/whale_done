{
  "name": "praiseboard",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "supabase:test:start": "supabase start --workdir test/supabase-local",
    "supabase:test:db:start": "supabase start --workdir test/supabase-local --exclude gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "supabase:test:reset": "supabase db reset --workdir test/supabase-local",
    "supabase:test:stop": "supabase stop --workdir test/supabase-local",
    "test:db": "supabase migration up --local --workdir test/supabase-local && supabase test db --workdir test/supabase-local",
    "test:integration": "node scripts/run-supabase-integration-tests.mjs",
    "storybook-generate": "sb-rn-get-stories",
    "storybook-expo:build": "EXPO_PUBLIC_STORYBOOK_ENABLED=true npx expo export --platform web"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@react-native-firebase/analytics": "^25.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@storybook/addon-ondevice-actions": "^10.2.3",
    "@storybook/addon-ondevice-controls": "^10.2.3",
    "@storybook/react-native": "^10.2.3",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/query-async-storage-persister": "^5.100.5",
    "@tanstack/react-query": "^5.100.5",
    "babel-loader": "^8.4.1",
    "expo": "~54.0.35",
    "expo-application": "~7.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
